+    def event_full(self, event_slug: str) -> dict | None:
+        """GET /v1/events/slug/{slug}: the event with its complete market list.
+
+        Since about 20:00 UTC on 15 Oct 2026 the league events feed embeds only
+        the headline full-game winner per event while `marketCounts.numMarkets`
+        reports 150-190; this endpoint still returns everything."""
+        data = self._get(f"/v1/events/slug/{event_slug}", {"groups": "false"})
+        if not data:
+            return None
+        return data.get("event") or data
+
     def league_events(self, league_slug: str, type_: str = "sport", page: int = 50) -> list[dict]:
