     return is_main
 
 
+def with_full_markets(client: "PolymarketUS", ev: dict) -> dict:
+    """Return the event with its full market list when the nested list is truncated.
+
+    The league feed's `marketCounts.numMarkets` says how many markets exist; when
+    the embedded list is shorter (one market since 15 Oct 2026), fetch the event
+    by slug and merge, keeping the league feed's own fields where the full
+    document lacks them."""
+    nested = ev.get("markets") or []
+    counts = ev.get("marketCounts") or {}
+    want = int(counts.get("numMarkets") or 0) > len(nested) or len(nested) <= 1
+    if not want or not ev.get("slug"):
+        return ev
+    try:
+        full = client.event_full(ev["slug"])
+    except Exception as e:  # noqa: BLE001  keep the pass alive
+        print(f"[warn] event_full {ev.get('slug')}: {e}")
+        return ev
+    if not full or not (full.get("markets") or []):
+        return ev
+    return {**ev, **{k: v for k, v in full.items() if v is not None}}
+
